################################################################################
# DocuRural — Entorno de Pruebas
# terraform.tfvars.example — Plantilla de valores
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp terraform.tfvars.example terraform.tfvars
#   2. Completar los valores con los datos reales
#   3. NUNCA subir terraform.tfvars a Git (ya está en .gitignore)
################################################################################

# Región de AWS
aws_region = "us-east-1"

# Tipo de instancia (no bajar de t3.small)
instance_type = "t3.small"

# Ruta a tu clave pública SSH
# Generarla con: ssh-keygen -t ed25519 -f ~/.ssh/docurural-test-key -C "docurural-test"
ssh_public_key_path = "~/.ssh/docurural-test-key.pub"

# Tu IP para acceso SSH (buscarla en: https://checkip.amazonaws.com)
admin_ip = "190.XXX.XXX.XXX/32"

# IPs del equipo de QA para acceso a PostgreSQL desde PgAdmin
qa_ips = [
  "190.XXX.XXX.XXX/32",   # QA principal
  # "190.YYY.YYY.YYY/32", # QA secundario (descomentar si aplica)
]

# ID de la Hosted Zone de Route 53
# Encontrarlo en: Route 53 → Hosted zones → seleccionar la zona → copiar "Hosted zone ID"
route53_zone_id = "Z0XXXXXXXXXXXXXXXXX"

# Dominio completo para el entorno de pruebas
domain_name = "pruebas.ccplsolutions.link"

# Contraseña de PostgreSQL (mínimo 12 caracteres)
db_password = "CambiarEstaContrasena2026!"

# Credenciales del administrador inicial (seed de Flyway)
admin_seed_email    = "admin@test.docurural.co"
admin_seed_password = "Admin2026!"

# Clave secreta JWT (mínimo 32 caracteres, usar una cadena aleatoria larga)
# Generar con: openssl rand -base64 48
jwt_secret = "DocuRuralTestSecretCambiarPorUnaClaveSeguraYLarga2026"
